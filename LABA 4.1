#include <iostream>
#include <cmath>

using namespace std;

int main()
{
	setlocale(LC_ALL, "Ukraine");
	int k, N;
	double P;

	cout << "N = "; cin >> N;

	// 1) цикл while
	P = 1;
	k = N;
	while (k <= 19)
	{
		P *= (1.0 * (k - N) / (k + N) + 1);
		k++;
	}
	cout << P << endl;

	// 2) цикл do-while
	P = 1;
	k = N;
	do {
		P *= (1.0 * (k - N) / (k + N) + 1);
		k++;
	} while (k <= 19);
	cout << P << endl;

	// 3) цикл for (вгору)
	P = 1;
	for (k = N; k <= 19; k++)
	{
		P *= (1.0 * (k - N) / (k + N) + 1);
	}
	cout << P << endl;

	// 4) цикл for (вниз)
	P = 1;
	for (k = 19; k >= N; k--)
	{
		P *= (1.0 * (k - N) / (k + N) + 1);
	}
	cout << P << endl;

	return 0;
